# Copy to .env at the repo root (gitignored). Do not commit passwords.

FS_HOST=192.168.1.2
FS_USER=walter
# Prefer a key when the file exists; otherwise FS_SSH_PASSWORD is used.
FS_SSH_KEY=
FS_SSH_PASSWORD=

FS_DOCKER_CONTAINER=freeswitch
FS_CLI=/usr/local/freeswitch/bin/fs_cli
FS_LOG=/usr/local/freeswitch/log/freeswitch.log
FS_CONF=/usr/local/freeswitch/conf

FS_PCAP_DIR=/tmp
FS_CAPTURE_IFACE=any
FS_CAPTURE_FILTER=port 5060 or port 5066 or port 7443
