# Copy to backend/.env for local development. No SIP credentials belong here.

APP_ENVIRONMENT=development
APP_SIP_WEBSOCKET_URL=ws://127.0.0.1:7443
APP_SIP_DOMAIN=localhost
APP_ICE_SERVERS=[]
APP_FRONTEND_DIST_DIR=../frontend/dist
APP_REGISTRATION_MAX_RETRIES=5
APP_REGISTRATION_BASE_DELAY_MS=1000
APP_REGISTRATION_MAX_DELAY_MS=15000
APP_DTMF_PREFERRED_METHOD=rtp
